generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TestTable {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}

enum DocumentStatus {
  // Row + job created, not yet claimed by a worker.
  queued
  // Worker claimed the job, about to start.
  processing
  // Actively looping through pages (Vision/chunk/embed).
  rag_processing
  // All pages processed successfully; WorkDrive upload not yet successful.
  // Retrying only needs to resume WorkDrive, not RAG processing.
  rag_completed
  // Actively uploading the original PDF to WorkDrive.
  workdrive_uploading
  // Fully done: all pages processed AND WorkDrive succeeded.
  completed
  // Some (not all) pages failed permanently; WorkDrive attempted regardless.
  completed_with_errors
  // Fatal: invalid PDF, zero pages, or every page failed.
  failed

  @@map("document_status")
}

// A single uploaded PDF. The original PDF bytes are never stored in this app —
// only what is derived from it (chunks + page snapshots) lives in Supabase.
// The original itself is archived permanently in Zoho WorkDrive.
model Document {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // No customers/tenant table exists yet in this project, so this is a free-text
  // tenant identifier rather than a foreign key. Swap for a real FK once a
  // customers table exists.
  customerId   String         @default("default") @map("customer_id")
  fileName     String         @map("file_name")
  // SHA-256 of the original PDF bytes — used to detect duplicate uploads per
  // customer so we skip re-uploading/re-processing an identical file.
  sha256            String?  @map("sha256")
  workdriveFileId   String?  @map("workdrive_file_id")
  workdriveFolderId String?  @map("workdrive_folder_id")
  status       DocumentStatus @default(queued)
  pageCount    Int?           @map("page_count")
  processedPages Int?         @map("processed_pages")
  failedPages    Int?         @map("failed_pages")
  // Kept only while WorkDrive is still pending/failed so a retry can resume
  // the archive upload without needing the client to re-upload the PDF.
  tempFilePath String?        @map("temp_file_path")
  errorMessage String?        @map("error_message")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  chunks DocumentChunk[]
  pages  DocumentPage[]
  jobs   Job[]

  @@index([customerId])
  @@index([customerId, sha256])
  @@map("documents")
}

// Per-page resumable processing state. This is what makes a failed page
// (or a failed WorkDrive upload) retryable in isolation, without redoing
// already-successful Vision/embedding work for other pages.
model DocumentPage {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId          String    @map("document_id") @db.Uuid
  pageNumber          Int       @map("page_number")
  // pending | processing | embedding | completed | failed
  // (vision_processing | vision_completed no longer produced — Vision LLM
  // processing was removed; kept as valid historical values only.)
  status              String    @default("pending")
  retryCount          Int       @default(0) @map("retry_count")
  lastError           String?   @map("last_error")
  hasVisual           Boolean?  @map("has_visual")
  visionProcessed     Boolean   @default(false) @map("vision_processed")
  // Persisted Vision LLM output — lets a retry skip Vision entirely if it
  // already succeeded but a later stage (embedding/DB) failed.
  visionContent       String?   @map("vision_content")
  embeddingCompleted  Boolean   @default(false) @map("embedding_completed")
  startedAt           DateTime? @map("started_at")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
  @@index([documentId])
  @@index([status])
  @@map("document_pages")
}


// The actual RAG content: Vision-LLM-processed page understanding, chunked,
// with its embedding. customerId is denormalized from Document for cheap,
// join-free tenant isolation on the hot similarity-search path.
model DocumentChunk {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  customerId String   @map("customer_id")
  pageNumber Int      @map("page_number")
  chunkIndex Int      @map("chunk_index")
  content    String
  metadata   Json?
  // pgvector column — Prisma can't model `vector`, so it's Unsupported and
  // only ever touched via $queryRaw/$executeRaw. Dimension MUST match
  // EMBEDDING_DIMENSIONS / OPENAI_EMBEDDING_MODEL in .env (see embedding.service.js).
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber, chunkIndex])
  @@index([documentId, pageNumber])
  @@index([customerId])
  @@map("document_chunks")
}

// Hand-rolled PostgreSQL job queue (FOR UPDATE SKIP LOCKED claim pattern) —
// no Redis/BullMQ. One job per document ("process_document"); document_pages
// already owns page-level resumable state, so jobs stay document-granular
// and don't duplicate that tracking. pageNumber/payload exist for future use
// but are unused by the current worker.
model Job {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobType     String    @map("job_type")
  documentId  String?   @map("document_id") @db.Uuid
  pageNumber  Int?      @map("page_number")
  payload     Json?
  // pending | running | completed | failed
  status      String    @default("pending")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  runAt       DateTime  @default(now()) @map("run_at")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  document Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([documentId, status])
  @@map("jobs")
}
