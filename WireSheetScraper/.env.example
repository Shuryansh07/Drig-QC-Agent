# Copy this file to .env and fill it in. Never put real secrets in THIS file —
# .env.example is committed to git. Real values go in .env (gitignored).
WIRESHEET_PASSWORD=
# Optional: a Cookie header copied from a logged-in browser, used instead of the password
# WIRESHEET_COOKIE=

# --- Progress + scraped data (PostgreSQL) --- the scraper stores everything in
# the DB so it resumes after a restart (nothing is kept on local disk). Point it
# at the same RDS as the backend, connecting as drig_app (NOT the admin role).
# No password in the URL — the DB password comes from Secrets Manager.
WIRESHEET_DATABASE_URL=postgresql://drig_app@drig-postgres.xxxx.us-east-1.rds.amazonaws.com:5432/postgres
# The DB password comes from AWS Secrets Manager (the secret's JSON "password"
# field). Needs secretsmanager:GetSecretValue on the task/IAM role.
# The URL user must match whose password is in this secret (drig_app -> drig_app
# secret; the RDS master secret -> user drigadmin).
DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:...:secret:...
# Local-dev fallback only (ignored when DB_SECRET_ARN is set):
# WIRESHEET_DB_PASSWORD=
# RDS requires TLS; point this at the RDS global bundle to verify the server cert.
# Leave unset to still use TLS but skip cert verification (fine for a trusted VPC).
DB_SSL_CA_PATH=../BackEnd/certs/global-bundle.pem
# Optional: the org these rows belong to (default "DRIG USA")
# WIRESHEET_ORG_NAME=DRIG USA

# --- Photo storage (S3) --- dedicated qc-wiresheet bucket. Credentials come from
# the default AWS chain (these two env vars, or a profile / the ECS task role).
# Skip photos entirely with --no-s3 for a quick local test.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_WIRESHEET_BUCKET=qc-wiresheet
S3_REGION=us-east-1
# Optional: key prefix inside the bucket (default none, since it is dedicated);
# keys end up <prefix>img/<sha256>.<ext> and <prefix>thumb/<sha256>.jpg
# S3_WIRESHEET_PREFIX=
# Optional: how long the tracker's photo links stay valid, in days (default 7,
# the max a long-term IAM user key can sign for)
# WIRESHEET_REPORT_LINK_DAYS=7
