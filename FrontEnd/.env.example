# Copy to .env.local. Never commit a filled-in copy — .gitignore allows only this file.

# Base URL the API client prefixes onto every request.
# Leave as /api in development so the Vite proxy handles it.
VITE_API_BASE_URL=/api

# Where the Vite dev server proxies /api to. Backend is not built yet.
VITE_API_PROXY=http://localhost:8080

# Auth tenant the technician signs into.
VITE_AUTH_ORG_ID=

# Turn the TanStack Query devtools panel on in development.
VITE_QUERY_DEVTOOLS=false
